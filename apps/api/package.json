{
  "name": "@sys4sys/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "smoke": "tsx src/smoke.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "db:backup": "tsx src/db/backup-cli.ts",
    "db:encrypt-secrets": "tsx src/db/encrypt-secrets-cli.ts",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@sys4sys/agent": "workspace:*",
    "@sys4sys/ai": "workspace:*",
    "@sys4sys/mail": "workspace:*",
    "@sys4sys/policy": "workspace:*",
    "@sys4sys/shared": "workspace:*",
    "@types/cross-spawn": "^6.0.6",
    "better-sqlite3": "^12.4.1",
    "cross-spawn": "^7.0.6",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.6.1",
    "hash-wasm": "^4.12.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.10.1",
    "drizzle-kit": "^0.31.6",
    "pino-pretty": "^13.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
