# API
HOST=127.0.0.1
PORT=8787
DATABASE_URL=./data/sys4sys.db
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# 初期管理者（初回起動時のみ使用）
ADMIN_EMAIL=admin@sys4sys.local
# 12 文字以上。空なら初回起動時にランダム生成してログに表示（開発時のみ）
ADMIN_PASSWORD=

# ログイン試行制限
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# CSRF/Origin 検証。カンマ区切りで許可する Web/API の Origin を指定
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8787,http://localhost:8787

# メール（設定画面で保存した値が優先。未設定ならこの env を使用）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# カンマ区切り。空なら有効な admin / operator のメールアドレスへ送る
MAIL_RECIPIENTS=

# 監視・自動復旧
MONITOR_ENABLED=true
MONITOR_INTERVAL_SEC=15
MONITOR_STARTUP_DELAY_SEC=5
# 0 でハートビート監視を無効化
MONITOR_HEARTBEAT_TIMEOUT_SEC=0
MONITOR_ERROR_LOG_WINDOW_SEC=300
# 0 でエラーログ件数ルールを無効化
MONITOR_ERROR_LOG_THRESHOLD=0
# 空でログパターン監視を無効化（正規表現）
MONITOR_LOG_PATTERN=
INCIDENT_DEDUPE_MINUTES=10
AUTO_RESTART_COOLDOWN_SEC=60
AUTO_RESTART_MAX_ATTEMPTS=3
AUTO_RESTART_WINDOW_SEC=600
AUTO_RESTART_BACKOFF_SEC=10,30,90
AUTO_RESTART_VERIFY_TIMEOUT_SEC=30

# メール内リンク
APP_BASE_URL=http://127.0.0.1:3000

# AI（OpenAI 互換 / BYOK）
# 設定画面で保存した値が優先。未設定ならこの env を使用。
# ローカル LLM の例: LM Studio 1234 / Ollama 11434 / llama.cpp 8081
AI_BASE_URL=http://localhost:8081/v1
AI_MODEL=
AI_API_KEY=
AI_MAX_INPUT_TOKENS=8000
AI_TEMPERATURE=0.2
AI_TIMEOUT_SEC=60
AI_DAILY_LIMIT=200
# false の場合、localhost / プライベート IP 以外のエンドポイントへログを送らない
AI_SEND_LOGS_EXTERNALLY=false

# サービス実行
# 許可する実行ファイル（カンマ区切り）。シェル文字列ではなく配列で spawn する
SERVICE_COMMAND_ALLOWLIST=node,node.exe,pnpm,pnpm.cmd,npm,npm.cmd,npx,npx.cmd,bun,bun.exe,deno,deno.exe,python,python.exe,python3,python3.exe,uvicorn,uvicorn.exe,go,go.exe,dotnet,dotnet.exe,java,java.exe,ruby,ruby.exe,php,php.exe,sh,bash,pwsh,pwsh.exe,powershell,powershell.exe
SERVICE_STOP_GRACE_MS=5000
SERVICE_AUTOSTART_ON_BOOT=false

# ログ
LOG_RETENTION_DAYS=14
LOG_TAIL_POLL_MS=1000
LOG_MAX_LINE_CHARS=8000
LOG_MAX_TAIL_BYTES=1048576
