# API
HOST=127.0.0.1
PORT=8787
DATABASE_URL=./data/sys4sys.db
SESSION_SECRET=change-me-to-a-long-random-string
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# 初期管理者（初回起動時のみ使用）
ADMIN_EMAIL=admin@sys4sys.local
# 12 文字以上。空なら初回起動時にランダム生成してログに表示（開発時のみ）
ADMIN_PASSWORD=

# ログイン試行制限
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# メール（未定のため空でよい）
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
MAIL_RECIPIENTS=

# AI（OpenAI 互換 / BYOK）
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=
AI_API_KEY=
AI_DAILY_LIMIT=200

# ログ
LOG_RETENTION_DAYS=14
