{
  "name": "sys4sys-workspace",
  "private": true,
  "version": "0.3.0",
  "license": "MIT",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sys4sys/api --filter @sys4sys/web dev",
    "dev:api": "pnpm --filter @sys4sys/api dev",
    "dev:web": "pnpm --filter @sys4sys/web dev",
    "scan": "pnpm --filter @sys4sys/agent scan",
    "sys4sys": "tsx apps/cli/src/bin.ts",
    "build": "pnpm -r build",
    "build:cli": "pnpm --filter sys4sys build",
    "pack:cli": "pnpm --filter sys4sys pack",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter sys4sys test:e2e",
    "db:generate": "pnpm --filter @sys4sys/api db:generate",
    "db:migrate": "pnpm --filter @sys4sys/api db:migrate",
    "db:backup": "pnpm --filter @sys4sys/api db:backup",
    "schema:generate": "tsx apps/cli/src/scripts/generate-schema.ts --write docs/cli-schema.json",
    "bench:cli": "node scripts/bench-cli.mjs",
    "demo:build": "pnpm --filter @sys4sys/demo-api build",
    "demo:start": "pnpm --filter @sys4sys/demo-api start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
