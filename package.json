{
  "name": "sys4sys",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @sys4sys/api --filter @sys4sys/web dev",
    "dev:api": "pnpm --filter @sys4sys/api dev",
    "dev:web": "pnpm --filter @sys4sys/web dev",
    "scan": "pnpm --filter @sys4sys/agent scan",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @sys4sys/api db:generate",
    "db:migrate": "pnpm --filter @sys4sys/api db:migrate",
    "db:backup": "pnpm --filter @sys4sys/api db:backup",
    "demo:build": "pnpm --filter @sys4sys/demo-api build",
    "demo:start": "pnpm --filter @sys4sys/demo-api start",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "yaml": "^2.8.1"
  }
}
