{
  "schemaVersion": "1",
  "cliVersion": "0.1.0",
  "auth": {
    "methods": [
      "token",
      "session"
    ],
    "tokenHeader": "Authorization: Bearer <token>"
  },
  "exitCodes": {
    "0": "success",
    "1": "general error",
    "2": "usage error",
    "3": "auth error",
    "4": "conflict",
    "5": "async failure"
  },
  "commands": [
    {
      "name": "whoami",
      "summary": "現在の認証ユーザーを表示",
      "description": "認証方式・ロール・スコープを表示する。トークン全文は表示しない。",
      "phase": "P0",
      "mutating": false,
      "requiresConfirmation": false,
      "requiredScopes": [],
      "positionals": [],
      "options": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string",
            "description": "API のルート URL",
            "default": "http://127.0.0.1:8787"
          },
          "json": {
            "type": "boolean",
            "description": "JSON で出力"
          },
          "help": {
            "type": "boolean",
            "description": "ヘルプを表示"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        "sys4sys whoami",
        "sys4sys whoami --json"
      ]
    },
    {
      "name": "auth login",
      "summary": "メール/パスワードでログインして資格情報を保存",
      "description": "パスワードは --password-stdin または TTY の hidden prompt で受け取る。既存の保存トークンは削除する。",
      "phase": "P0",
      "mutating": false,
      "requiresConfirmation": false,
      "requiredScopes": [],
      "positionals": [],
      "options": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string",
            "description": "API のルート URL",
            "default": "http://127.0.0.1:8787"
          },
          "json": {
            "type": "boolean",
            "description": "JSON で出力"
          },
          "help": {
            "type": "boolean",
            "description": "ヘルプを表示"
          },
          "email": {
            "type": "string",
            "description": "ログインメール"
          },
          "password-stdin": {
            "type": "boolean",
            "description": "標準入力からパスワードを読む"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        "sys4sys auth login --email admin@example.local --password-stdin"
      ]
    },
    {
      "name": "auth logout",
      "summary": "保存済みの資格情報を削除",
      "description": "保存済みトークンは --revoke-token で API 失効できる。環境変数のトークンは失効しない。",
      "phase": "P0",
      "mutating": true,
      "requiresConfirmation": false,
      "requiredScopes": [],
      "positionals": [],
      "options": {
        "type": "object",
        "properties": {
          "api": {
            "type": "string",
            "description": "API のルート URL",
            "default": "http://127.0.0.1:8787"
          },
          "json": {
            "type": "boolean",
            "description": "JSON で出力"
          },
          "help": {
            "type": "boolean",
            "description": "ヘルプを表示"
          },
          "revoke-token": {
            "type": "boolean",
            "description": "保存済みトークンの API 失効を必須にする"
          }
        },
        "additionalProperties": false
      },
      "examples": [
        "sys4sys auth logout",
        "sys4sys auth logout --revoke-token"
